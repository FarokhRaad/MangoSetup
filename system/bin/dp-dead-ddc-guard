#!/usr/bin/env bash
# =============================================================================
#  dp-dead-ddc-guard - deny DDC access to i2c buses whose DDC never works
# =============================================================================
#  PROBLEM
#  Some display links (notably a DisplayPort connector behind a passive
#  USB-C -> HDMI adaptor) expose an i2c/DDC bus that NEVER answers. On
#  DisplayPort, DDC rides the AUX channel, which is the same channel used for
#  link training and hotplug detect. Every failed DDC probe burns ~2.5s of AUX
#  traffic, and doing that while the link is renegotiating (login, resume) makes
#  the monitor come up slowly or not at all.
#
#  WHY AN APP-LEVEL FIX IS NOT ENOUGH
#  Every DDC consumer brute-forces all buses, because the NVIDIA driver
#  publishes raw i2c adapters with NO /sys/class/drm/<conn>/ddc symlink to tie a
#  bus to a connector. Verified consumers:
#    - KDE powerdevil : fixed via POWERDEVIL_NO_DDCUTIL=1 (KDE only)
#    - DankMaterialShell : core/internal/server/brightness/ddc.go loops
#      i2c-0..31 and probes anything its filter does not skip. Its filter skips
#      driver "nouveau", names like SMBus / AMDGPU SMU / Synopsys DesignWare,
#      and non-display PCI classes. NVIDIA proprietary buses are named
#      "NVIDIA i2c adapter N at X:00.0" with driver="" and class unset, so they
#      match NOTHING and are all probed. It rescans every 30s (scanInterval),
#      and only skips buses that previously ANSWERED, so a dead bus is
#      re-probed forever. There is no env var or setting to turn DDC off.
#    - ddcutil / fastfetch's brightness module : same brute force on demand
#  So the block has to be below the app layer: make the device node
#  inaccessible and every consumer fails instantly with EACCES instead of
#  hammering AUX.
#
#  MEASURED on the affected machine (BenQ GW2381 on DP-2 via USB-C adaptor):
#    dead bus, mode 660 : 2627 ms per probe  (DDC communication failed)
#    dead bus, mode 000 :   11 ms per probe  (EACCES, instant)
#    live HDMI bus      : unaffected, still returns brightness
#
#  BUS NUMBERS ARE NOT STABLE, so this script never hardcodes one. It resolves
#  connector -> bus at runtime and writes a udev rule keyed on the i2c adapter
#  NAME (e.g. "NVIDIA i2c adapter 4 at 1:00.0"), which is stable for a given
#  GPU/connector pairing while the /dev/i2c-N numbering is not.
#
#  Usage (invoked by 30-system-tweaks.sh; also runnable directly):
#    dp-dead-ddc-guard detect                 list buses and DDC health
#    dp-dead-ddc-guard install <CONNECTOR>    block the bus behind CONNECTOR
#    dp-dead-ddc-guard status                 show whether a rule is installed
#    dp-dead-ddc-guard remove                 delete the rule
#
#  Requires: ddcutil (to test DDC health and map bus -> connector)
# =============================================================================
set -uo pipefail

RULE=/etc/udev/rules.d/89-dead-ddc-bus.rules
GREEN=$'\033[0;32m'; RED=$'\033[0;31m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; NC=$'\033[0m'
ok()   { printf '%s[ OK ]%s %s\n' "$GREEN" "$NC" "$*"; }
err()  { printf '%s[FAIL]%s %s\n' "$RED" "$NC" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$YELLOW" "$NC" "$*"; }
info() { printf '%s[INFO]%s %s\n' "$BLUE" "$NC" "$*"; }

bus_name() { cat "/sys/bus/i2c/devices/i2c-$1/name" 2>/dev/null; }

#  Map DRM connector -> i2c bus number using ddcutil's own view, which is the
#  only reliable source here (the kernel ddc symlink is absent on NVIDIA).
#  NOTE: ddcutil labels the connector "DRM_connector:" (underscore) when run
#  as a normal user and "DRM connector:" (space) under sudo. Match both.
bus_for_connector() {
  local want="$1" bus="" conn=""
  while IFS= read -r line; do
    case "$line" in
      *"/dev/i2c-"*)  bus="${line##*/dev/i2c-}"; bus="${bus%%[^0-9]*}" ;;
      *DRM?connector:*)
        conn="${line##*:}"; conn="${conn//[[:space:]]/}"
        [[ -n "$bus" && "$conn" == *"$want" ]] && { printf '%s\n' "$bus"; return 0; } ;;
    esac
  done < <(ddcutil detect 2>/dev/null)
  return 1
}

#  Is DDC really dead on this bus?
#
#  A SINGLE probe is not enough. Measured on real hardware, a genuinely working
#  HDMI bus answered on attempt 1 and then failed attempts 2 and 3 in a row:
#
#    try1 rc=0 3853ms  current value = 100      <- works
#    try2 rc=1 2156ms  DDC communication failed
#    try3 rc=1 2171ms  DDC communication failed
#
#  DDC over i2c is genuinely flaky (contention, a monitor busy with its own
#  OSD, a link mid-renegotiation). Treating one failure as proof of death would
#  let this tool block a WORKING monitor's brightness, which is the one
#  outcome it must never cause.
#
#  So: dead only if EVERY attempt fails. Any single success proves the bus is
#  alive and we return immediately, keeping the common healthy case fast.
DDC_TRIES=${DDC_TRIES:-3}
ddc_is_dead() {
  local bus="$1" i
  for ((i = 1; i <= DDC_TRIES; i++)); do
    ddcutil --bus "$bus" getvcp 0x10 >/dev/null 2>&1 && return 1
    ((i < DDC_TRIES)) && sleep 1
  done
  return 0
}

cmd_detect() {
  local n
  command -v ddcutil >/dev/null 2>&1 || { err "ddcutil is required for detection"; return 2; }
  printf '%-8s %-38s %-16s %s\n' "BUS" "ADAPTER NAME" "CONNECTOR" "DDC"
  local bus="" conn="" st
  while IFS= read -r line; do
    case "$line" in
      *"/dev/i2c-"*) bus="${line##*/dev/i2c-}"; bus="${bus%%[^0-9]*}" ;;
      *DRM?connector:*)
        conn="${line##*:}"; conn="${conn//[[:space:]]/}"
        [[ -n "$bus" ]] || continue
        n=$(bus_name "$bus")
        if ddc_is_dead "$bus"; then st="${RED}dead${NC}"; else st="${GREEN}works${NC}"; fi
        printf '%-8s %-38s %-16s %b\n' "i2c-$bus" "${n:-?}" "${conn:-?}" "$st"
        bus=""
        ;;
    esac
  done < <(ddcutil detect 2>/dev/null)
}

cmd_status() {
  if [[ -f "$RULE" ]]; then
    ok "rule installed: $RULE"
    grep -E '^ATTR|^#  connector' "$RULE" | sed 's/^/    /'
    return 0
  fi
  info "no dead-DDC rule installed"
  return 1
}

cmd_install() {
  local conn="${1:-}"
  [[ -n "$conn" ]] || { err "usage: $0 install <CONNECTOR>   (e.g. DP-2)"; return 2; }
  command -v ddcutil >/dev/null 2>&1 || { err "ddcutil is required"; return 2; }

  local bus name
  bus=$(bus_for_connector "$conn") || { err "no i2c bus maps to connector '$conn'"; return 1; }
  name=$(bus_name "$bus")
  [[ -n "$name" ]] || { err "could not read the adapter name for i2c-$bus"; return 1; }

  #  Refuse to block a bus whose DDC actually works: that would silently kill
  #  working external brightness control.
  if ! ddc_is_dead "$bus"; then
    err "DDC on $conn (i2c-$bus) WORKS. Blocking it would break brightness control."
    err "Only dead buses should be blocked. Nothing was changed."
    return 1
  fi

  info "connector $conn -> i2c-$bus  ($name)"
  info "DDC confirmed dead on that bus; installing udev rule"

  #  Keyed on ATTR{name}, not the bus number: /dev/i2c-N renumbers across
  #  reboots, the adapter name does not.
  cat <<EOF | sudo tee "$RULE" >/dev/null
# Deny DDC access to an i2c bus whose DDC never answers.
#
#  connector : $conn
#  adapter   : $name
#
# Written by MangoSetup's dp-dead-ddc-guard. See that script's header for the
# full reasoning and measurements. Matching is on ATTR{name} because the
# /dev/i2c-N number is NOT stable across reboots.
#
# Effect: DDC consumers (DankMaterialShell, ddcutil, fastfetch's brightness
# module) get EACCES instantly (~11ms) instead of hammering the DisplayPort AUX
# channel for ~2.5s per probe, which was making this monitor wake slowly or not
# at all.
#
# Cost: software brightness/contrast over THIS monitor is gone. It never worked
# on this link anyway (that is why the bus is dead). Its physical buttons, the
# laptop panel, and other monitors are unaffected.
ACTION=="add|change", SUBSYSTEM=="i2c-dev", ATTR{name}=="$name", MODE="0000"
EOF
  sudo chmod 644 "$RULE"
  ok "wrote $RULE"

  if sudo udevadm control --reload-rules >/dev/null 2>&1; then
    sudo udevadm trigger --subsystem-match=i2c-dev >/dev/null 2>&1 || true
    ok "udev rules reloaded and retriggered"
  else
    warn "rule written but udev reload failed; it applies on next boot"
  fi

  local mode
  mode=$(stat -c '%a' "/dev/i2c-$bus" 2>/dev/null)
  if [[ "$mode" == "0" ]]; then
    ok "/dev/i2c-$bus is now mode 000 (DDC consumers will skip it instantly)"
  else
    warn "/dev/i2c-$bus is still mode ${mode:-?}; takes effect after a reboot"
  fi
}

cmd_remove() {
  [[ -f "$RULE" ]] || { info "nothing to remove"; return 0; }
  sudo rm -f "$RULE"
  sudo udevadm control --reload-rules >/dev/null 2>&1 || true
  sudo udevadm trigger --subsystem-match=i2c-dev >/dev/null 2>&1 || true
  ok "removed $RULE (DDC probing of that bus resumes)"
}

case "${1:-detect}" in
  detect)  cmd_detect ;;
  install) shift; cmd_install "${1:-}" ;;
  status)  cmd_status ;;
  remove)  cmd_remove ;;
  *) err "unknown command '$1'"; sed -n '44,50p' "${BASH_SOURCE[0]}"; exit 2 ;;
esac
