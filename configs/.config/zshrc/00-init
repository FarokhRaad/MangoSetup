# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR=nvim
export VISUAL=code
export PATH="$HOME/.local/bin:$PATH"

# Claude Code config lives outside $HOME on this machine so it survives a
# reinstall. Override CLAUDE_CONFIG_DIR before this file loads to relocate it;
# if the directory does not exist, everything here is skipped.
: "${CLAUDE_CONFIG_DIR:=/mnt/Data/Claude/config}"
export CLAUDE_CONFIG_DIR
# Claude sometimes writes this file read-only, which then blocks its own
# updates. Only touch it if it is actually there.
[ -f "$CLAUDE_CONFIG_DIR/.claude.json" ] && chmod u+rw "$CLAUDE_CONFIG_DIR/.claude.json" 2>/dev/null

# -----------------------------------------------------
# Plugins
# -----------------------------------------------------
# Installed from the repos when zsh is picked in the setup wizard
# (packages/app-catalog.txt lists them as SHELL companions). Sourced only if
# present, so a zsh without them still starts cleanly.
# Order matters: syntax highlighting must be sourced LAST of the two.
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] \
  && source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] \
  && source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Completion. compinit is expensive, so use a cached dump and only rebuild it
# once a day.
autoload -Uz compinit
if [ -n "$(find "${ZDOTDIR:-$HOME}/.zcompdump" -mtime +1 2>/dev/null)" ] \
   || [ ! -f "${ZDOTDIR:-$HOME}/.zcompdump" ]; then
  compinit
else
  compinit -C
fi
