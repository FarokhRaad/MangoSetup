# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

# -----------------------------------------------------
# General
# -----------------------------------------------------
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias ls='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'


# -----------------------------------------------------
# Git
# -----------------------------------------------------
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"
alias gcredential="git config credential.helper store"


# -----------------------------------------------------
# System
# -----------------------------------------------------
alias pac-update='sudo pacman -Syu'
alias pac-install='sudo pacman -S'
alias pac-remove='sudo pacman -Rns'
alias pac-search='pacman -Ss'
alias pac-cleanup='sudo pacman -Rns $(pacman -Qtdq)'
alias reboot='sudo systemctl reboot'
alias poweroff='sudo systemctl poweroff'
alias suspend='systemctl suspend'
alias hibernate='systemctl hibernate'
alias lock='loginctl lock-session'

# -----------------------------------------------------
# mango / DMS
# -----------------------------------------------------
#  Quick reload after editing a mango config file by hand.
alias mango-reload='mmsg dispatch reload_config'
#  Lint the live config against a real mango source tree; see
#  MangoSetup/scripts/validate-config.sh.
alias mango-validate='~/MangoSetup/scripts/validate-config.sh ~/.config/mango'

# -----------------------------------------------------
# SPM: force fzf preview shell to bash
# -----------------------------------------------------
#  /usr/bin/spm (package spm-arch) is a #!/bin/bash script that drives fzf, and
#  fzf runs its --bind / --preview strings through $SHELL rather than through
#  bash. Under a zsh login shell those strings are handed to zsh, but they use
#  bash test syntax such as [[ $w =~ ^[0-9]+$ ]] in the alt-[ / alt-] preview
#  width bindings, so the bindings misbehave.
#
#  Overriding SHELL for this one command only is the minimal fix: it does not
#  change your login shell, and it does not affect anything else spm calls.
#  Only needed for zsh, which is why there is no equivalent in the bash config.
alias spm='SHELL=/bin/bash /usr/bin/spm'
