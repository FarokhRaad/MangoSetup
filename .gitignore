# =============================================================================
#  MangoSetup .gitignore
# =============================================================================
#  This repo is deployed via SYMLINKS (scripts/20-symlink.sh): every file
#  under configs/ is symlinked into its real $HOME location, so the repo and
#  the live config are the same inodes. That makes it easy for runtime state,
#  caches and timestamped backups to appear inside configs/ by accident.
#  Everything below keeps that noise out of git.
# =============================================================================

# --- Local-only notes (NEVER commit) ----------------------------------------
#  NOTES.local.md and anything else matching *.local.* is working documentation
#  for this machine: LAN addresses, disk UUIDs, monitor names, credentials
#  discussion, and the reasoning behind decisions. The public README is the
#  sanitised version. Keep this pattern ABOVE any negated rules so nothing can
#  re-include it by accident.
NOTES.local.md
*.local.md
*.local.conf
.notes/

# --- Timestamped backups made by the scripts themselves ---------------------
#  20-symlink.sh and 40-root-symlink.sh back up (never delete) any real file
#  they would overwrite, and this session's manual edits do the same.
#  These belong on disk, not in history.
.backups/
*.bak
*.bak-*
*.pre-mangosetup-*
*.orig
*.rej

# --- Wizard / script run state ----------------------------------------------
#  setup.sh's STATE_DIR logs and per-step markers.
.state/
*.log

# --- Files the SHELL generates into config dirs ------------------------------
#  DankMaterialShell owns these. `dms setup <fragment>` regenerates them, and
#  its Settings UI rewrites cursor/outputs/windowrules live, so they are
#  OUTPUT, not source. config.conf sources them with source-optional= exactly
#  so a fresh clone works before `dms setup` has ever run.
configs/.config/mango/dms/

#  matugen/DMS-generated theme output for GTK and Qt.
configs/.config/qt5ct/colors/*.conf
configs/.config/qt6ct/colors/*.conf
configs/.config/gtk-3.0/*-colors.css
configs/.config/gtk-4.0/*-colors.css

# --- DMS runtime state -------------------------------------------------------
#  Written by the shell at runtime, per-machine, not configuration.
configs/.config/DankMaterialShell/settings.json
configs/.config/DankMaterialShell/session.json
configs/.config/DankMaterialShell/clsettings.json
configs/.config/DankMaterialShell/plugin_settings.json
configs/.config/DankMaterialShell/dms-colors.json

# --- Caches that can land under a symlinked config dir ----------------------
configs/.config/fontconfig/cache/
**/__pycache__/
*.pyc

# --- Editor / OS noise ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
